# Supabase — SERVER-SIDE ONLY.
# Copy this file to ".env.local" and fill in real values, then restart `npm run dev`.
#
# Where to find them: Supabase dashboard → Project Settings → API
#   - Project URL          -> SUPABASE_URL
#   - service_role secret  -> SUPABASE_SERVICE_ROLE_KEY
#
# IMPORTANT: the service_role key bypasses Row Level Security and must NEVER be
# exposed to the browser. Do NOT rename it with a NEXT_PUBLIC_ prefix.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — SERVER-SIDE ONLY.
# Where to find them: Resend dashboard → API Keys
#   - Create a key with "Sending access" → RESEND_API_KEY
#
# Sender: verify your domain at https://resend.com/domains and set
# RESEND_FROM_EMAIL to that address (e.g. "Artfolio <hello@artstudio.app>").
# Until the domain is verified, only "onboarding@resend.dev" works, and it
# only delivers to the email you registered your Resend account with.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Artfolio <onboarding@resend.dev>
